pipeline {

    agent any

    environment {
        TERRAFORM_DIR = "terraform/environments/dev"
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir(TERRAFORM_DIR) {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Destroy') {
            steps {
                input message: '⚠️ Approve Terraform Destroy? This will delete AWS resources'
                dir(TERRAFORM_DIR) {
                    sh 'terraform destroy -auto-approve'
                }
            }
        }
    }

    post {
        success {
            echo "🧨 Infrastructure destroyed successfully"
        }
        failure {
            echo "❌ Destroy failed — check logs"
        }
    }
}
