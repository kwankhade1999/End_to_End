pipeline {

    agent any

    parameters {
        booleanParam(
            name: 'DESTROY',
            defaultValue: false,
            description: 'If true, Terraform DESTROY will run instead of APPLY'
        )
    }

    environment {
        TERRAFORM_DIR = "terraform/environments/dev"
        ANSIBLE_DIR   = "ansible"
        INVENTORY_GEN = "ansible/scripts/generate_inventory.sh"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir(TERRAFORM_DIR) {
                    sh '''
                      terraform init -reconfigure
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir(TERRAFORM_DIR) {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Apply / Destroy') {
            steps {
                script {
                    if (params.DESTROY) {
                        input message: '⚠️ Approve Terraform DESTROY? This will delete ALL AWS resources.'
                        dir(TERRAFORM_DIR) {
                            sh 'terraform destroy -auto-approve'
                        }
                    } else {
                        input message: 'Approve Terraform APPLY?'
                        dir(TERRAFORM_DIR) {
                            sh 'terraform apply -auto-approve'
                        }
                    }
                }
            }
        }

        stage('Generate Ansible Inventory') {
            when {
                expression { !params.DESTROY }
            }
            steps {
                sh '''
                  chmod +x ${INVENTORY_GEN}
                  ${INVENTORY_GEN}
                '''
            }
        }

        stage('Ansible Configuration') {
            when {
                expression { !params.DESTROY }
            }
            steps {
                sshagent(credentials: ['ec2-ap-south']) {
                    dir(ANSIBLE_DIR) {
                        sh '''
                          ansible-playbook site.yml \
                          -i inventories/dev/hosts.ini
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (params.DESTROY) {
                    echo "🧨 Infrastructure destroyed successfully"
                } else {
                    echo "✅ End-to-End DevOps platform deployed successfully"
                }
            }
        }
        failure {
            echo "❌ Pipeline failed — check logs carefully"
        }
        aborted {
            echo "⏸️ Pipeline aborted by user"
        }
    }
}
